# TLS in front of Cardiotic AI. Replace the names and certificate paths; keep the headers.
server {
    listen 443 ssl http2;
    server_name cardiotic.hospital.example;
    ssl_certificate     /etc/ssl/certs/cardiotic.crt;
    ssl_certificate_key /etc/ssl/private/cardiotic.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 300m;                 # Holter files; the server's own limit is CARDIOTIC_MAX_UPLOAD (256 MB)
    proxy_read_timeout 120s;

    location / {
        proxy_pass http://127.0.0.1:8720;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
server { listen 80; server_name cardiotic.hospital.example; return 301 https://$host$request_uri; }
